    {
      "id": "jobs.leftovers.shell-exit-then-end",
      "description": "When the shell exits leaving a background process in its group, the job is 'exited' (with the shell's code) until the group is empty, then 'ended' with the same code. The leftover lives until the scenario kills it, so 'exited' lasts as long as the poll needs.",
      "requires": {
        "jobs": "native"
      },
      "steps": [
        {
          "id": "start",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "ah01",
          "command": "sh",
          "args": [
            "-c",
            "sleep 30 & echo main; exit 5"
          ],
          "label": "",
          "expect": {
            "ok": {
              "pgid": {
                "$gt": 0
              }
            }
          }
        },
        {
          "id": "exited",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "ah01",
          "offset": 0,
          "poll": {
            "timeout_ms": 8000,
            "interval_ms": 20
          },
          "expect": {
            "ok": {
              "state": "exited",
              "code": 5,
              "data_utf8": "main\n"
            }
          }
        },
        {
          "id": "kill",
          "op": "job_kill",
          "scope": "${SCOPE}",
          "jobs": [
            "ah01"
          ],
          "expect": {
            "ok": {
              "survivors": []
            }
          }
        },
        {
          "id": "ended",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "ah01",
          "offset": 0,
          "poll": {
            "timeout_ms": 8000,
            "interval_ms": 50
          },
          "expect": {
            "ok": {
              "state": "ended",
              "code": 5
            }
          }
        }
      ]
    },
    {
      "id": "jobs.leftovers.attach-waits-for-the-group",
      "description": "attach does not end at the shell's exit but when the group is empty; the status is the shell's.",
