            "ok": {
              "jobs": [
                {
                  "id": "ae01"
                }
              ]
            }
          }
        },
        {
          "id": "third-list",
          "op": "job_list",
          "scope": "${SCOPE}-third",
          "expect": {
            "ok": {
              "jobs": []
            }
          }
        },
        {
          "id": "third-read",
          "op": "job_read",
