{
  "suite": "bulk",
  "version": 1,
  "description": "Layer 2: bulk copy as tar over exec. Planned (T7): skipped, never counted as passes.",
  "scenarios": [
    {
      "id": "bulk.upload-dir.extracts-a-tar",
      "description": "upload_dir sends a tar stream and unpacks it under a directory, creating it.",
      "planned": "T7",
      "steps": [
        {
          "id": "up",
          "op": "upload_dir",
          "path": "${ROOT}/dst",
          "tar_b64": "",
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "a",
          "op": "read",
          "path": "${ROOT}/dst/a.txt",
          "expect": {
            "ok": {
              "data_utf8": "alpha\n"
            }
          }
        },
        {
          "id": "b",
          "op": "read",
          "path": "${ROOT}/dst/sub/b.bin",
          "expect": {
            "ok": {
              "data_sha256": "40aff2e9d2d8922e47afd4648e6967497158785fbd1da870e7110266bf944880"
            }
          }
        }
      ]
    },
    {
      "id": "bulk.download-dir.returns-a-tar",
      "description": "download_dir returns a tar stream of a directory's contents, relative to it.",
      "planned": "T7",
      "setup": [
        {
          "id": "setup",
          "op": "exec",
          "command": "sh",
          "args": [
            "-c",
            "set -e; cd \"$1\"; mkdir -p src/sub; echo alpha > src/a.txt; head -c 256 /dev/zero > src/sub/b.bin",
            "sh",
            "${ROOT}"
          ]
        }
      ],
      "steps": [
        {
          "id": "down",
          "op": "download_dir",
          "path": "${ROOT}/src",
          "expect": {
            "ok": {
              "tar_entries": {
                "$unordered": [
                  {
                    "path": "a.txt",
                    "size": 6
                  },
                  {
                    "path": "sub/b.bin",
                    "size": 256
                  }
                ]
              }
            }
          }
        }
      ]
    },
    {
      "id": "bulk.round-trip",
      "description": "A directory uploaded and downloaded again has the same files with the same bytes.",
      "planned": "T7",
      "steps": [
        {
          "id": "up",
          "op": "upload_dir",
          "path": "${ROOT}/x",
          "tar_b64": "",
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "down",
          "op": "download_dir",
          "path": "${ROOT}/x",
          "expect": {
            "ok": {
              "tar_entries": {
                "$unordered": [
                  {
                    "path": "a.txt",
                    "size": 6
                  },
                  {
                    "path": "sub/b.bin",
                    "size": 256
                  }
                ]
              }
            }
          }
        }
      ]
    },
    {
      "id": "bulk.upload-dir.refuses-escaping-paths",
      "description": "An archive member that would land outside the target directory ('../x' or an absolute path) is refused and nothing is written.",
      "planned": "T7",
      "steps": [
        {
          "id": "up",
          "op": "upload_dir",
          "path": "${ROOT}/dst",
          "tar_b64": "",
          "expect": {
            "error": {
              "kind": "invalid_request"
            }
          }
        },
        {
          "id": "none",
          "op": "stat",
          "path": "${ROOT}/escape.txt",
          "expect": {
            "ok": {
              "exists": false
            }
          }
        }
      ]
    }
  ]
}
