{
  "suite": "exec-bytes",
  "version": 1,
  "description": "Layer 1: raw exec output is bytes. stdout and stderr are always exactly what the command wrote.",
  "scenarios": [
    {
      "id": "exec-bytes.stdout.all-256-values",
      "description": "Raw exec of a command that writes every byte value 0x00 to 0xFF returns exactly those 256 bytes on stdout. Invalid UTF-8 and NULs are not replaced.",
      "steps": [
        {
          "id": "s",
          "op": "exec",
          "command": "sh",
          "args": [
            "-c",
            "i=0; while [ $i -lt 256 ]; do printf \"\\\\$(printf %03o $i)\"; i=$((i+1)); done"
          ],
          "expect": {
            "ok": {
              "exit_code": 0,
              "stdout_b64": "",
              "stdout_len": 256,
              "stderr_len": 0
            }
          }
        }
      ]
    },
    {
      "id": "exec-bytes.stderr.all-256-values",
      "description": "The same on stderr.",
      "steps": [
        {
          "id": "s",
          "op": "exec",
          "command": "sh",
          "args": [
            "-c",
            "i=0; while [ $i -lt 256 ]; do printf \"\\\\$(printf %03o $i)\"; i=$((i+1)); done >&2"
          ],
          "expect": {
            "ok": {
              "exit_code": 0,
              "stderr_b64": "",
              "stderr_len": 256,
              "stdout_len": 0
            }
          }
        }
      ]
    },
    {
      "id": "exec-bytes.both-streams.kept-apart",
      "description": "Binary output on both streams arrives on its own stream, with the exit code.",
      "steps": [
        {
          "id": "s",
          "op": "exec",
          "command": "sh",
          "args": [
            "-c",
            "printf '\\377\\000\\001' ; printf '\\376\\000\\002' >&2; exit 7"
          ],
          "expect": {
            "ok": {
              "exit_code": 7,
              "stdout_b64": "/wAB",
              "stderr_b64": "/gAC"
            }
          }
        }
      ]
    },
    {
      "id": "exec-bytes.invalid-utf8.shapes",
      "description": "Each way to be invalid UTF-8 survives: a truncated multi-byte sequence, an overlong encoding, an encoded surrogate, a lone continuation byte, a code point past U+10FFFF, and a byte-order mark.",
      "steps": [
        {
          "id": "s",
          "op": "exec",
          "command": "sh",
          "args": [
            "-c",
            "printf '\\303|\\300\\200|\\355\\240\\200|\\200|\\364\\220\\200\\200|\\357\\273\\277|\\360\\237'"
          ],
          "expect": {
            "ok": {
              "exit_code": 0,
              "stdout_b64": "w3zAgHztoIB8gHz0kICAfO+7v3zwnw=="
            }
          }
        }
      ]
    },
    {
      "id": "exec-bytes.large.multi-chunk",
      "description": "256 KiB of binary (the 256 byte values 1024 times) crosses many frames or one big base64 string intact.",
      "steps": [
        {
          "id": "s",
          "op": "exec",
          "command": "sh",
          "args": [
            "-c",
            "i=0; while [ $i -lt 256 ]; do printf \"\\\\$(printf %03o $i)\"; i=$((i+1)); done > \"$0\"; n=0; while [ $n -lt 1024 ]; do cat \"$0\"; n=$((n+1)); done",
            "${ROOT}/block"
          ],
          "timeout_ms": 60000,
          "expect": {
            "ok": {
              "exit_code": 0,
              "stdout_len": 262144,
              "stdout_sha256": "2312394bd99545d9de131c24efb781e765ac1aec243f2ed9347597a793a415e9"
            }
          }
        }
      ]
    },
    {
      "id": "exec-bytes.text.unchanged",
      "description": "Valid UTF-8 text (multi-byte characters, CRLF, an emoji) comes back byte for byte.",
      "steps": [
        {
          "id": "s",
          "op": "exec",
          "command": "sh",
          "args": [
            "-c",
            "printf 'caf\\303\\251 \\346\\274\\242 \\360\\237\\230\\200\\r\\nend'"
          ],
          "expect": {
            "ok": {
              "exit_code": 0,
              "stdout_b64": "Y2Fmw6kg5ryiIPCfmIANCmVuZA==",
              "stdout_utf8": "café 漢 😀\r\nend"
            }
          }
        }
      ]
    },
    {
      "id": "exec-bytes.exit.signal-and-timeout",
      "description": "The exit code is 128+N for a signal, 124 and the timeout note for a deadline.",
      "steps": [
        {
          "id": "signal",
          "op": "exec",
          "command": "sh",
          "args": [
            "-c",
            "printf '\\377'; kill -9 $$"
          ],
          "expect": {
            "ok": {
              "exit_code": 137
            }
          }
        },
        {
          "id": "timeout",
          "op": "exec",
          "command": "sh",
          "args": [
            "-c",
            "printf '\\377' >&2; sleep 30"
          ],
          "timeout_ms": 700,
          "expect": {
            "ok": {
              "exit_code": 124,
              "stderr_utf8": {
                "$re": "command exceeded its timeout$"
              }
            }
          }
        }
      ]
    },
    {
      "id": "exec-bytes.stdin.binary-through-cat",
      "description": "Binary stdin comes back as binary stdout .",
      "steps": [
        {
          "id": "s",
          "op": "exec",
          "command": "cat",
          "args": [],
          "stdin_b64": "",
          "expect": {
            "ok": {
              "exit_code": 0,
              "stdout_b64": ""
            }
          }
        }
      ]
    },
    {
      "id": "exec-bytes.roundtrip.gzip",
      "description": "A user helper built on raw exec: gzip a binary file, take the compressed bytes into the client, write them back with the files helper, and gunzip: the original, byte for byte.",
      "requires": {
        "commands": [
          "gzip"
        ]
      },
      "steps": [
        {
          "id": "src",
          "op": "write",
          "path": "${ROOT}/src",
          "data_b64": {
            "$repeat": {
              "b64": "",
              "times": 4,
              "len": 1024
            }
          },
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "gz",
          "op": "exec",
          "command": "sh",
          "args": [
            "-c",
            "gzip -nc \"$0\"",
            "${ROOT}/src"
          ],
          "save": {
            "gz": "stdout_b64"
          },
          "expect": {
            "ok": {
              "exit_code": 0
            }
          }
        },
        {
          "id": "put",
          "op": "write",
          "path": "${ROOT}/src.gz",
          "data_b64": "${gz}",
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "back",
          "op": "exec",
          "command": "sh",
          "args": [
            "-c",
            "gzip -dc \"$0\"",
            "${ROOT}/src.gz"
          ],
          "expect": {
            "ok": {
              "exit_code": 0,
              "stdout_len": 1024,
              "stdout_sha256": "785b0751fc2c53dc14a4ce3d800e69ef9ce1009eb327ccf458afe09c242c26c9"
            }
          }
        }
      ]
    },
    {
      "id": "exec-bytes.relay.files-to-exec",
      "description": "A writes the 256 byte values with the files helper; B reads the same file back through raw exec (cat) and gets identical bytes, both ways round.",
      "same_driver": true,
      "steps": [
        {
          "id": "w",
          "op": "write",
          "path": "${ROOT}/rel",
          "data_b64": "",
          "expect": {
            "ok": {}
          },
          "via": "A"
        },
        {
          "id": "cat",
          "op": "exec",
          "command": "sh",
          "args": [
            "-c",
            "cat \"$0\"",
            "${ROOT}/rel"
          ],
          "expect": {
            "ok": {
              "exit_code": 0,
              "stdout_b64": "",
              "stdout_len": 256
            }
          },
          "via": "B"
        },
        {
          "id": "gen",
          "op": "exec",
          "command": "sh",
          "args": [
            "-c",
            "i=0; while [ $i -lt 256 ]; do printf \"\\\\$(printf %03o $i)\"; i=$((i+1)); done > \"$0\"",
            "${ROOT}/rel2"
          ],
          "expect": {
            "ok": {
              "exit_code": 0
            }
          },
          "via": "B"
        },
        {
          "id": "read",
          "op": "read",
          "path": "${ROOT}/rel2",
          "expect": {
            "ok": {
              "data_b64": ""
            }
          },
          "via": "A"
        }
      ]
    },
    {
      "id": "exec-bytes.relay.exec-bytes-written-by-other",
      "description": "A takes compressed bytes from a raw exec; B writes them to a file with the files helper; A reads the file back through raw exec: unchanged.",
      "requires": {
        "commands": [
          "gzip"
        ]
      },
      "same_driver": true,
      "steps": [
        {
          "id": "src",
          "op": "write",
          "path": "${ROOT}/rel",
          "data_b64": {
            "$repeat": {
              "b64": "",
              "times": 4,
              "len": 1024
            }
          },
          "expect": {
            "ok": {}
          },
          "via": "A"
        },
        {
          "id": "gz",
          "op": "exec",
          "command": "sh",
          "args": [
            "-c",
            "gzip -nc \"$0\"",
            "${ROOT}/rel"
          ],
          "save": {
            "gz": "stdout_b64"
          },
          "expect": {
            "ok": {
              "exit_code": 0
            }
          },
          "via": "A"
        },
        {
          "id": "put",
          "op": "write",
          "path": "${ROOT}/rel.gz",
          "data_b64": "${gz}",
          "expect": {
            "ok": {}
          },
          "via": "B"
        },
        {
          "id": "back",
          "op": "exec",
          "command": "sh",
          "args": [
            "-c",
            "gzip -dc \"$0\"",
            "${ROOT}/rel.gz"
          ],
          "expect": {
            "ok": {
              "exit_code": 0,
              "stdout_len": 1024,
              "stdout_sha256": "785b0751fc2c53dc14a4ce3d800e69ef9ce1009eb327ccf458afe09c242c26c9"
            }
          },
          "via": "A"
        }
      ]
    },
    {
      "id": "exec-bytes.stdout.large-output-decodes",
      "description": "Raw exec with 7 MB of stdout returns exactly 7,000,000 bytes. Large base64 bodies (over 6 MB) must decode in every client.",
      "steps": [
        {
          "id": "s",
          "op": "exec",
          "command": "sh",
          "args": [
            "-c",
            "head -c 7000000 /dev/zero"
          ],
          "timeout_ms": 60000,
          "expect": {
            "ok": {
              "exit_code": 0,
              "stdout_len": 7000000
            }
          }
        }
      ]
    }
  ]
}
