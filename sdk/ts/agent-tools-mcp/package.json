{
  "name": "@beyond.dev/agent-tools-mcp",
  "version": "0.1.0-dev",
  "description": "Eve/Agent-SDK-compatible defineTool (Zod/Standard Schema) as an MCP server in a Beyond sandbox.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beyondoss/ai.git",
    "directory": "sdk/ts/agent-tools-mcp"
  },
  "bin": {
    "beyond-agent-tools-mcp": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./eve-tools": {
      "bun": "./src/eve-tools.ts",
      "types": "./dist/eve-tools.d.mts",
      "import": "./dist/eve-tools.mjs",
      "default": "./src/eve-tools.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "compile": "bash scripts/compile.sh",
    "manifest:example": "bun run src/cli.ts manifest --dir examples/weather/tools --name tools"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "peerDependencies": {
    "zod": ">=3.24.0",
    "zod-to-json-schema": ">=3.23.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "zod-to-json-schema": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "zod": "^4.1.5"
  }
}
