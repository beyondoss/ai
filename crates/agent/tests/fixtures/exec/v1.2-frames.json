{
  "spec": "exec protocol v1.2 streamed response (crates/agent/src/exec_endpoint.rs, \"Streaming (v1.2)\")",
  "notes": [
    "Each case is the body of one application/x-ndjson response, one string per line, without the trailing newline.",
    "expect.stdout_base64 / expect.stderr_base64 are the bytes a conforming client hands the caller, in order.",
    "expect.heartbeats counts frames that carry nothing: they keep the connection alive and are never output.",
    "expect.shell_exits lists the shell_exit codes, in order: the shell exited but processes of its group kept running, so the stream stayed open. Never output, never final.",
    "expect.end is the final frame; null means the body ended without one, which a client MUST report as a broken stream.",
    "expect.invalid means a conforming client MUST reject the body."
  ],
  "cases": [
    {
      "name": "one line of stdout, then exit 0",
      "lines": ["{\"stdout\":\"aGVsbG8K\"}", "{\"exit_code\":0}"],
      "expect": {
        "stdout_base64": "aGVsbG8K",
        "stderr_base64": "",
        "heartbeats": 0,
        "end": { "exit_code": 0 }
      }
    },
    {
      "name": "interleaved streams with a heartbeat in a silence, non-zero exit",
      "lines": [
        "{\"stdout\":\"aGVsbG8K\"}",
        "{}",
        "{\"stderr\":\"b29wcwo=\"}",
        "{\"stdout\":\"d29ybGQK\"}",
        "{\"exit_code\":3}"
      ],
      "expect": {
        "stdout_base64": "aGVsbG8Kd29ybGQK",
        "stderr_base64": "b29wcwo=",
        "heartbeats": 1,
        "end": { "exit_code": 3 }
      }
    },
    {
      "name": "arbitrary bytes survive (0xff 0x00 0x01)",
      "lines": ["{\"stdout\":\"/wAB\"}", "{\"exit_code\":0}"],
      "expect": {
        "stdout_base64": "/wAB",
        "stderr_base64": "",
        "heartbeats": 0,
        "end": { "exit_code": 0 }
      }
    },
    {
      "name": "the shell exits leaving a process running; the stream ends when it does",
      "lines": [
        "{\"stdout\":\"c3RhcnRlZAo=\"}",
        "{\"shell_exit\":0}",
        "{}",
        "{\"stdout\":\"bGF0ZQo=\"}",
        "{\"exit_code\":0}"
      ],
      "expect": {
        "stdout_base64": "c3RhcnRlZApsYXRlCg==",
        "stderr_base64": "",
        "heartbeats": 1,
        "shell_exits": [0],
        "end": { "exit_code": 0 }
      }
    },
    {
      "name": "killed by a signal",
      "lines": ["{\"stdout\":\"aGVsbG8K\"}", "{\"signal\":9}"],
      "expect": {
        "stdout_base64": "aGVsbG8K",
        "stderr_base64": "",
        "heartbeats": 0,
        "end": { "signal": 9 }
      }
    },
    {
      "name": "the endpoint enforced timeout_ms",
      "lines": ["{}", "{}", "{\"timed_out\":true}"],
      "expect": {
        "stdout_base64": "",
        "stderr_base64": "",
        "heartbeats": 2,
        "end": { "timed_out": true }
      }
    },
    {
      "name": "the endpoint failed mid-command",
      "lines": ["{\"stdout\":\"aGVsbG8K\"}", "{\"error\":\"sandbox lost\"}"],
      "expect": {
        "stdout_base64": "aGVsbG8K",
        "stderr_base64": "",
        "heartbeats": 0,
        "end": { "error": "sandbox lost" }
      }
    },
    {
      "name": "unknown fields are ignored; a frame with no known field is a heartbeat",
      "lines": [
        "{\"stdout\":\"aGVsbG8K\",\"seq\":1}",
        "{\"progress\":50}",
        "{\"exit_code\":0,\"elapsed_ms\":12}"
      ],
      "expect": {
        "stdout_base64": "aGVsbG8K",
        "stderr_base64": "",
        "heartbeats": 1,
        "end": { "exit_code": 0 }
      }
    },
    {
      "name": "CRLF line endings and blank lines are tolerated",
      "lines": ["{\"stdout\":\"aGVsbG8K\"}\r", "", "{\"exit_code\":0}\r"],
      "expect": {
        "stdout_base64": "aGVsbG8K",
        "stderr_base64": "",
        "heartbeats": 1,
        "end": { "exit_code": 0 }
      }
    },
    {
      "name": "the body ended before the final frame",
      "lines": ["{\"stdout\":\"aGVsbG8K\"}", "{}"],
      "expect": {
        "stdout_base64": "aGVsbG8K",
        "stderr_base64": "",
        "heartbeats": 1,
        "end": null
      }
    },
    {
      "name": "output is base64, never raw text",
      "lines": ["{\"stdout\":\"hello world!\"}", "{\"exit_code\":0}"],
      "expect": { "invalid": true }
    },
    {
      "name": "a line that is not JSON",
      "lines": ["stdout: hello"],
      "expect": { "invalid": true }
    }
  ]
}
