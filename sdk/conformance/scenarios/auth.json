    {
      "id": "auth.token.403-is-final",
      "description": "A 403 is not an expired token: the client does not ask its source again and does not repeat the request.",
      "connect": {
        "edge": {
          "tokens": true
        }
      },
      "setup": [
        {
          "id": "warm",
          "op": "capabilities"
        },
        {
          "id": "zero",
          "edge": {
            "reset": true
          }
        }
      ],
      "steps": [
        {
          "id": "forbid",
          "edge": {
            "set": {
              "fault": {
                "kind": "status",
                "status": 403,
                "body": "{\"error\":\"forbidden\"}"
              }
            }
          },
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "exec",
          "op": "exec",
          "command": "echo",
          "args": [
            "hi"
          ],
          "expect": {
            "error": {
              "kind": "auth"
            }
          }
        },
        {
          "id": "once",
          "edge": {
            "reset": true
          },
          "expect": {
            "ok": {
              "requests": 1,
              "mints": 0
            }
          }
        }
      ]
    }
  ]
