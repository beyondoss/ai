              "code": 137
            }
          }
        }
      ]
    },
    {
      "id": "jobs.exit.shell-command-not-found",
      "description": "A job whose shell cannot find its command ends with 127. (Starting a program that does not exist at all is refused by a native endpoint with an error status and is an ended job with 127 on the baseline: callers wrap commands in sh -c to get one behaviour.)",
      "requires": {
        "jobs": "any"
      },
      "steps": [
        {
          "id": "start",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "aa07",
          "command": "sh",
          "args": [
            "-c",
            "no-such-command-xyz"
          ],
          "label": "",
          "expect": {
            "ok": {
              "pgid": {
                "$gt": 0
              }
            }
          }
        },
        {
          "id": "ended",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "aa07",
          "offset": 0,
          "poll": {
            "timeout_ms": 8000,
            "interval_ms": 50
          },
          "expect": {
            "ok": {
              "state": "ended",
              "code": 127
            }
          }
        }
      ]
    },
    {
      "id": "jobs.output.stdout-and-stderr-are-one-stream",
      "description": "stdout and stderr are one combined output, in the order the bytes were written (best effort between the two).",
      "requires": {
        "jobs": "any"
      },
      "steps": [
        {
          "id": "start",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "aa08",
          "command": "sh",
          "args": [
            "-c",
            "echo out; echo err >&2"
          ],
          "label": "",
          "expect": {
            "ok": {
              "pgid": {
                "$gt": 0
              }
            }
          }
        },
        {
          "id": "ended",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "aa08",
          "offset": 0,
          "poll": {
            "timeout_ms": 8000,
            "interval_ms": 50
          },
          "expect": {
            "ok": {
              "state": "ended",
              "code": 0,
              "data_utf8": {
                "$oneof": [
                  "out\nerr\n",
                  "err\nout\n"
                ]
              },
              "end": 8
            }
          }
        }
      ]
    },
    {
      "id": "jobs.output.binary-exact",
      "description": "Job output is bytes: all 256 values come back exactly.",
      "requires": {
        "jobs": "any"
      },
      "steps": [
        {
          "id": "start",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "aa09",
          "command": "sh",
          "args": [
            "-c",
            "i=0; while [ $i -lt 256 ]; do printf \"\\\\$(printf %03o $i)\"; i=$((i+1)); done"
          ],
          "label": "",
          "expect": {
            "ok": {
              "pgid": {
                "$gt": 0
              }
            }
          }
        },
        {
          "id": "ended",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "aa09",
          "offset": 0,
          "poll": {
            "timeout_ms": 8000,
            "interval_ms": 50
          },
          "expect": {
            "ok": {
              "state": "ended",
              "data_len": 256,
              "data_sha256": "40aff2e9d2d8922e47afd4648e6967497158785fbd1da870e7110266bf944880",
              "end": 256
            }
          }
        }
      ]
    },
