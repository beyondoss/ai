{
  "spec": "exec protocol v1.4 sandbox job notify (crates/agent/src/exec_endpoint.rs, \"Sandbox job notify (v1.4)\"), \"Adoption\"",
  "notes": [
    "answers: the body an endpoint returns to the v1.3 probe (sh -c 'printf exec-v1.2' carrying \"job\": {\"op\": \"probe\"}), and what a conforming client reads from it: native_jobs (v1.3) and notify (v1.4)."
  ],
  "answers": [
    {
      "name": "a v1.4 endpoint",
      "answer": {
        "jobs": "v1.3",
        "notify": "v1.4"
      },
      "expect": {
        "native_jobs": true,
        "notify": true
      },
      "covers": [
        "N1",
        "N2"
      ]
    },
    {
      "name": "a v1.4 endpoint with a field this client does not know",
      "answer": {
        "jobs": "v1.3",
        "notify": "v1.4",
        "seq": 1
      },
      "expect": {
        "native_jobs": true,
        "notify": true
      },
      "covers": [
        "N2"
      ]
    },
    {
      "name": "a v1.3 endpoint",
      "answer": {
        "jobs": "v1.3"
      },
      "expect": {
        "native_jobs": true,
        "notify": false
      },
      "covers": [
        "N2"
      ]
    },
    {
      "name": "jobs bumped to v1.4: no native jobs, so no notify",
      "answer": {
        "jobs": "v1.4",
        "notify": "v1.4"
      },
      "expect": {
        "native_jobs": false,
        "notify": false
      },
      "covers": [
        "N1",
        "N2"
      ]
    },
    {
      "name": "a later notify version",
      "answer": {
        "jobs": "v1.3",
        "notify": "v1.5"
      },
      "expect": {
        "native_jobs": true,
        "notify": false
      },
      "covers": [
        "N2"
      ]
    },
    {
      "name": "notify as a boolean",
      "answer": {
        "jobs": "v1.3",
        "notify": true
      },
      "expect": {
        "native_jobs": true,
        "notify": false
      },
      "covers": [
        "N2"
      ]
    },
    {
      "name": "notify without native jobs",
      "answer": {
        "notify": "v1.4"
      },
      "expect": {
        "native_jobs": false,
        "notify": false
      },
      "covers": [
        "N2"
      ]
    },
    {
      "name": "a v1.1 or v1.2 endpoint ran the probe's command",
      "answer": {
        "exit_code": 0,
        "stdout": "exec-v1.2",
        "stderr": ""
      },
      "expect": {
        "native_jobs": false,
        "notify": false
      },
      "covers": [
        "N2"
      ]
    }
  ]
}
