{
  "suite": "jobs",
  "version": 1,
  "description": "Layer 1: sandbox jobs (v1.3 natively; plain exec commands otherwise).",
  "scenarios": [
    {
      "id": "jobs.start.runs-and-ends",
      "description": "A started job runs on its own: its combined output is readable from offset 0, and it ends with the shell's exit code.",
      "requires": {
        "jobs": "any"
      },
      "steps": [
        {
          "id": "start",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "aa01",
          "command": "sh",
          "args": [
            "-c",
            "echo hello; sleep 0.3; echo bye"
          ],
          "label": "",
          "expect": {
            "ok": {
              "pgid": {
                "$gt": 0
              }
            }
          }
        },
        {
          "id": "ended",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "aa01",
          "offset": 0,
          "poll": {
            "timeout_ms": 8000,
            "interval_ms": 50
          },
          "expect": {
            "ok": {
              "state": "ended",
              "code": 0,
              "offset": 0,
              "end": 10,
              "data_utf8": "hello\nbye\n"
            }
          }
        }
      ]
    },
    {
      "id": "jobs.start.pgid-is-the-process-group",
      "description": "start answers with the job's process group, which leads a group of its own.",
      "requires": {
        "jobs": "any"
      },
      "steps": [
        {
          "id": "start",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "aa02",
          "command": "sh",
          "args": [
            "-c",
            "sleep 30"
          ],
          "label": "",
          "expect": {
            "ok": {
              "pgid": {
                "$gt": 1
              }
            }
          }
        },
        {
          "id": "kill",
          "op": "job_kill",
          "scope": "${SCOPE}",
          "jobs": [
            "aa02"
          ],
          "expect": {
            "ok": {
              "survivors": []
            }
          }
        }
      ]
    },
    {
      "id": "jobs.read.window",
      "description": "read returns up to max bytes from offset, reports where the data starts (offset) and where the job's output ends so far (end, the same whatever max was), and an offset at the end is empty with the job's final state.",
      "requires": {
        "jobs": "any"
      },
      "steps": [
        {
          "id": "start",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "aa03",
          "command": "sh",
          "args": [
            "-c",
            "printf 0123456789"
          ],
          "label": "",
          "expect": {
            "ok": {
              "pgid": {
                "$gt": 0
              }
            }
          }
        },
        {
          "id": "wait",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "aa03",
          "offset": 0,
          "poll": {
            "timeout_ms": 8000,
            "interval_ms": 50
          },
          "expect": {
            "ok": {
              "state": "ended"
            }
          }
        },
        {
          "id": "head",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "aa03",
          "offset": 0,
          "max": 3,
          "expect": {
            "ok": {
              "state": "ended",
              "offset": 0,
              "end": 10,
              "data_utf8": "012"
            }
          }
        },
        {
          "id": "mid",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "aa03",
          "offset": 4,
          "max": 3,
          "expect": {
            "ok": {
              "offset": 4,
              "end": 10,
              "data_utf8": "456"
            }
          }
        },
        {
          "id": "tail",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "aa03",
          "offset": 7,
          "max": 100,
          "expect": {
            "ok": {
              "offset": 7,
              "end": 10,
              "data_utf8": "789"
            }
          }
        },
        {
          "id": "at-end",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "aa03",
          "offset": 10,
          "expect": {
            "ok": {
              "state": "ended",
              "code": 0,
              "end": 10,
              "data_len": 0
            }
          }
        },
        {
          "id": "past-end",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "aa03",
          "offset": 500,
          "expect": {
            "ok": {
              "state": "ended",
              "data_len": 0
            }
          }
        }
      ]
    },
    {
      "id": "jobs.read.sees-output-while-running",
      "description": "Output is readable while the job still runs, and state says running with no code.",
      "requires": {
        "jobs": "any"
      },
      "steps": [
        {
          "id": "start",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "aa04",
          "command": "sh",
          "args": [
            "-c",
            "echo first; sleep 30"
          ],
          "label": "",
          "expect": {
            "ok": {
              "pgid": {
                "$gt": 0
              }
            }
          }
        },
        {
          "id": "running",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "aa04",
          "offset": 0,
          "poll": {
            "timeout_ms": 8000,
            "interval_ms": 50
          },
          "expect": {
            "ok": {
              "state": "running",
              "code": null,
              "data_utf8": "first\n"
            }
          }
        },
        {
          "id": "kill",
          "op": "job_kill",
          "scope": "${SCOPE}",
          "jobs": [
            "aa04"
          ],
          "expect": {
            "ok": {}
          }
        }
      ]
    },
