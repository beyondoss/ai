{
  "suite": "auth",
  "version": 1,
  "description": "Auth through an edge that issues short-lived bearers: a token source (CONFORMANCE_TOKEN_CMD) is asked once, renewed on a 401 and the request repeated once, and its failure is an auth error.",
  "scenarios": [
    {
      "id": "auth.token.is-asked-once-and-kept",
      "description": "A token source is asked for a token before the first request and not again while the endpoint accepts it: later requests of every kind reuse the one it gave.",
      "connect": {
        "edge": {
          "tokens": true
        }
      },
      "setup": [
        {
          "id": "warm",
          "op": "capabilities"
        },
        {
          "id": "zero",
          "edge": {
            "reset": true
          }
        }
      ],
      "steps": [
        {
          "id": "exec",
          "op": "exec",
          "command": "echo",
          "args": [
            "hi"
          ],
          "expect": {
            "ok": {
              "exit_code": 0,
              "stdout_utf8": "hi\n"
            }
          }
        },
        {
          "id": "stream",
          "op": "exec_stream",
          "command": "echo",
          "args": [
            "hi"
          ],
          "expect": {
            "ok": {
              "stdout_utf8": "hi\n",
              "exit_code": 0
            }
          }
        },
        {
          "id": "stat",
          "op": "stat",
          "path": "${ROOT}",
          "expect": {
            "ok": {
              "exists": true
            }
          }
        },
        {
          "id": "job-list",
          "op": "job_list",
          "scope": "${SCOPE}",
          "expect": {
            "ok": {
              "jobs": []
            }
          }
        },
        {
          "id": "not-asked-again",
          "edge": {
            "reset": true
          },
          "expect": {
            "ok": {
              "mints": 0,
              "rejected": 0
            }
          }
        }
      ]
    },
    {
      "id": "auth.token.expired-mid-run-is-renewed-once",
      "description": "A token that stops working between two calls: the next call gets a 401, the client asks its source for a new token and repeats that one request once, and the run goes on with the new token. One 401, one new token, no second refresh later.",
      "connect": {
        "edge": {
          "tokens": true
        }
      },
      "setup": [
        {
          "id": "warm",
          "op": "capabilities"
        },
        {
          "id": "zero",
          "edge": {
            "reset": true
          }
        }
      ],
      "steps": [
        {
          "id": "before",
          "op": "exec",
          "command": "echo",
          "args": [
            "hi"
          ],
          "expect": {
            "ok": {
              "exit_code": 0,
              "stdout_utf8": "hi\n"
            }
          }
        },
        {
          "id": "expire",
          "edge": {
            "expire": true
          },
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "after",
          "op": "exec",
          "command": "echo",
          "args": [
            "hi"
          ],
          "expect": {
            "ok": {
              "exit_code": 0,
              "stdout_utf8": "hi\n"
            }
          }
        },
        {
          "id": "renewed-once",
          "edge": {
            "reset": true
          },
          "expect": {
            "ok": {
              "rejected": 1,
              "mints": 1
            }
          }
        },
        {
          "id": "and-after",
          "op": "exec",
          "command": "echo",
          "args": [
            "hi"
          ],
          "expect": {
            "ok": {
              "exit_code": 0,
              "stdout_utf8": "hi\n"
            }
          }
        },
        {
          "id": "then-quiet",
          "edge": {
            "reset": true
          },
          "expect": {
            "ok": {
              "rejected": 0,
              "mints": 0
            }
          }
        }
      ]
    },
    {
      "id": "auth.token.every-kind-of-call-renews",
      "description": "The renewal is in the transport, so every kind of call has it: the one-shot, the stream, the file helpers and the jobs each survive an expired token with exactly one 401 and one new token.",
      "connect": {
        "edge": {
          "tokens": true
        }
      },
      "setup": [
        {
          "id": "warm",
          "op": "capabilities"
        },
        {
          "id": "zero",
          "edge": {
            "reset": true
          }
        }
      ],
      "steps": [
        {
          "id": "expire-exec",
          "edge": {
            "expire": true
          },
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "exec",
          "op": "exec",
          "command": "echo",
          "args": [
            "hi"
          ],
          "expect": {
            "ok": {
              "exit_code": 0,
              "stdout_utf8": "hi\n"
            }
          }
        },
        {
          "id": "exec-renewed-once",
          "edge": {
            "reset": true
          },
          "expect": {
            "ok": {
              "rejected": 1,
              "mints": 1
            }
          }
        },
        {
          "id": "expire-exec-stream",
          "edge": {
            "expire": true
          },
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "exec-stream",
          "op": "exec_stream",
          "command": "echo",
          "args": [
            "hi"
          ],
          "expect": {
            "ok": {
              "stdout_utf8": "hi\n",
              "exit_code": 0
            }
          }
        },
        {
          "id": "exec-stream-renewed-once",
          "edge": {
            "reset": true
          },
          "expect": {
            "ok": {
              "rejected": 1,
              "mints": 1
            }
          }
        },
        {
          "id": "expire-file-stat",
          "edge": {
            "expire": true
          },
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "file-stat",
          "op": "stat",
          "path": "${ROOT}",
          "expect": {
            "ok": {
              "exists": true
            }
          }
        },
        {
          "id": "file-stat-renewed-once",
          "edge": {
            "reset": true
          },
          "expect": {
            "ok": {
              "rejected": 1,
              "mints": 1
            }
          }
        },
        {
          "id": "expire-file-write",
          "edge": {
            "expire": true
          },
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "file-write",
          "op": "write",
          "path": "${ROOT}/f",
          "data_b64": "eA==",
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "file-write-renewed-once",
          "edge": {
            "reset": true
          },
          "expect": {
            "ok": {
              "rejected": 1,
              "mints": 1
            }
          }
        },
        {
          "id": "file-read-put",
          "op": "write",
          "path": "${ROOT}/r",
          "data_b64": "eA==",
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "expire-file-read",
          "edge": {
            "expire": true
          },
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "file-read",
          "op": "read",
          "path": "${ROOT}/r",
          "expect": {
            "ok": {
              "data_utf8": "x"
            }
          }
        },
        {
          "id": "file-read-renewed-once",
          "edge": {
            "reset": true
          },
          "expect": {
            "ok": {
              "rejected": 1,
              "mints": 1
            }
          }
        },
        {
          "id": "expire-job-start",
          "edge": {
            "expire": true
          },
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "job-start",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "tk01",
          "command": "true",
          "args": [],
          "label": "",
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "job-start-renewed-once",
          "edge": {
            "reset": true
          },
          "expect": {
            "ok": {
              "rejected": 1,
              "mints": 1
            }
          }
        },
        {
          "id": "expire-job-list",
          "edge": {
            "expire": true
          },
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "job-list",
          "op": "job_list",
          "scope": "${SCOPE}",
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "job-list-renewed-once",
          "edge": {
            "reset": true
          },
          "expect": {
            "ok": {
              "rejected": 1,
              "mints": 1
            }
          }
        }
      ]
    },
    {
      "id": "auth.token.renewal-that-still-fails-is-auth",
      "description": "The source keeps giving a token the endpoint has refused: a call renews at most once, so the endpoint refuses it exactly twice (the token it held, and the renewed one, even when the source gave the same token again), one mint, and the call fails with auth, never a loop. The next call, once the source gives a good token, works.",
      "connect": {
        "edge": {
          "tokens": true
        }
      },
      "setup": [
        {
          "id": "warm",
          "op": "capabilities"
        },
        {
          "id": "zero",
          "edge": {
            "reset": true
          }
        }
      ],
      "steps": [
        {
          "id": "expire-without-a-new-token",
          "edge": {
            "expire": {
              "mint": false
            }
          },
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "refused",
          "op": "exec",
          "command": "echo",
          "args": [
            "hi"
          ],
          "expect": {
            "error": {
              "kind": "auth"
            }
          }
        },
        {
          "id": "bounded",
          "edge": {
            "reset": true
          },
          "expect": {
            "ok": {
              "rejected": 2,
              "mints": 1
            }
          }
        },
        {
          "id": "the-source-recovers",
          "edge": {
            "expire": true
          },
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "works-again",
          "op": "exec",
          "command": "echo",
          "args": [
            "hi"
          ],
          "expect": {
            "ok": {
              "exit_code": 0,
              "stdout_utf8": "hi\n"
            }
          }
        },
        {
          "id": "renewed-once",
          "edge": {
            "reset": true
          },
          "expect": {
            "ok": {
              "rejected": 1,
              "mints": 1
            }
          }
        }
      ]
    },
    {
      "id": "auth.token.command-that-fails-is-auth",
      "description": "A token source that cannot give a token (the command exits non-zero) is an auth error on every kind of call, not an io error, a crash or a request without credentials. Nothing reaches the endpoint.",
      "connect": {
        "edge": {
          "tokens": "fail"
        }
      },
      "steps": [
        {
          "id": "exec",
          "op": "exec",
          "command": "echo",
          "args": [
            "hi"
          ],
          "expect": {
            "error": {
              "kind": "auth"
            }
          },
          "xfail": {
            "drivers": [
              "agent-reference",
              "beyond-sandbox-ts",
              "python",
              "python-async",
              "sandbox-mcp"
            ],
            "reason": "a token source that fails is reported as io (Python: the source's own exception escapes), not auth"
          }
        },
        {
          "id": "exec-stream",
          "op": "exec_stream",
          "command": "echo",
          "args": [
            "hi"
          ],
          "expect": {
            "error": {
              "kind": "auth"
            }
          },
          "xfail": {
            "drivers": [
              "agent-reference",
              "beyond-sandbox-ts",
              "python",
              "python-async",
              "sandbox-mcp"
            ],
            "reason": "a token source that fails is reported as io (Python: the source's own exception escapes), not auth"
          }
        },
        {
          "id": "stat",
          "op": "stat",
          "path": "${ROOT}",
          "expect": {
            "error": {
              "kind": "auth"
            }
          },
          "xfail": {
            "drivers": [
              "agent-reference",
              "beyond-sandbox-ts",
              "python",
              "python-async",
              "sandbox-mcp"
            ],
            "reason": "a token source that fails is reported as io (Python: the source's own exception escapes), not auth"
          }
        },
        {
          "id": "write",
          "op": "write",
          "path": "${ROOT}/f",
          "data_b64": "eA==",
          "expect": {
            "error": {
              "kind": "auth"
            }
          },
          "xfail": {
            "drivers": [
              "agent-reference",
              "beyond-sandbox-ts",
              "python",
              "python-async",
              "sandbox-mcp"
            ],
            "reason": "a token source that fails is reported as io (Python: the source's own exception escapes), not auth"
          }
        },
        {
          "id": "job-start",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "tk01",
          "command": "true",
          "args": [],
          "label": "",
          "expect": {
            "error": {
              "kind": "auth"
            }
          },
          "xfail": {
            "drivers": [
              "agent-reference",
              "beyond-sandbox-ts",
              "python",
              "python-async",
              "sandbox-mcp"
            ],
            "reason": "a token source that fails is reported as io (Python: the source's own exception escapes), not auth"
          }
        },
        {
          "id": "job-list",
          "op": "job_list",
          "scope": "${SCOPE}",
          "expect": {
            "error": {
              "kind": "auth"
            }
          },
          "xfail": {
            "drivers": [
              "agent-reference",
              "beyond-sandbox-ts",
              "python",
              "python-async",
              "sandbox-mcp"
            ],
            "reason": "a token source that fails is reported as io (Python: the source's own exception escapes), not auth"
          }
        },
        {
          "id": "nothing-was-sent",
          "edge": {
            "reset": true
          },
          "expect": {
            "ok": {
              "requests": 0
            }
          }
        }
      ]
    },
