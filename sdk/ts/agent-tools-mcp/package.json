{
  "name": "@beyond.dev/agent-tools-mcp",
  "version": "0.1.0-dev",
  "description": "Run Eve/Agent-SDK-shaped tools/*.ts as an MCP server in a Beyond sandbox. Pack with bun compile --trim --smol.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beyondoss/ai.git",
    "directory": "sdk/ts/agent-tools-mcp"
  },
  "bin": {
    "beyond-agent-tools-mcp": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./eve-tools": {
      "import": "./dist/eve-tools.mjs",
      "types": "./dist/eve-tools.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "compile": "bash scripts/compile.sh",
    "manifest:example": "bun run src/cli.ts manifest --dir examples/weather/tools --name tools"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
