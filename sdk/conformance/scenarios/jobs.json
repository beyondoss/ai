            "ok": {
              "state": "ended",
              "data_utf8": "/\n"
            }
          }
        }
      ]
    },
    {
      "id": "jobs.list.fields",
      "description": "list shows the scope's jobs with id, state, code, kept, label and start time; a running job has no code.",
      "requires": {
        "jobs": "any"
      },
      "steps": [
        {
          "id": "start",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "aa13",
          "command": "sh",
          "args": [
            "-c",
            "sleep 30"
          ],
          "label": "my server",
          "expect": {
            "ok": {
              "pgid": {
                "$gt": 0
              }
            }
          }
        },
        {
          "id": "list",
          "op": "job_list",
          "scope": "${SCOPE}",
          "expect": {
            "ok": {
              "jobs": [
                {
                  "id": "aa13",
                  "state": "running",
                  "code": null,
                  "kept": true,
                  "label": "my server",
                  "started": {
                    "$gt": 1000000000
                  },
                  "ended": 0
                }
              ]
            }
          }
        },
        {
          "id": "kill",
          "op": "job_kill",
          "scope": "${SCOPE}",
          "jobs": [
            "aa13"
          ],
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "ended",
          "op": "job_list",
          "scope": "${SCOPE}",
          "poll": {
            "timeout_ms": 8000,
            "interval_ms": 50
          },
          "expect": {
            "ok": {
              "jobs": [
                {
                  "id": "aa13",
                  "state": "ended",
                  "code": {
                    "$oneof": [
                      137,
                      143
                    ]
                  },
                  "ended": {
                    "$gt": 1000000000
                  }
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "jobs.list.several",
      "description": "list returns every job of the scope, ended ones until removed.",
      "requires": {
        "jobs": "any"
      },
      "steps": [
        {
          "id": "one",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "ab01",
          "command": "sh",
          "args": [
            "-c",
            "exit 0"
          ],
          "label": "",
          "expect": {
            "ok": {
              "pgid": {
                "$gt": 0
              }
            }
          }
        },
        {
          "id": "two",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "ab02",
          "command": "sh",
          "args": [
            "-c",
            "sleep 30"
          ],
          "label": "",
          "expect": {
            "ok": {
              "pgid": {
                "$gt": 0
              }
            }
          }
        },
        {
          "id": "three",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "ab03",
          "command": "sh",
          "args": [
            "-c",
            "exit 3"
          ],
          "label": "",
          "expect": {
            "ok": {
              "pgid": {
                "$gt": 0
              }
            }
          }
        },
        {
          "id": "list",
          "op": "job_list",
          "scope": "${SCOPE}",
          "poll": {
            "timeout_ms": 8000,
            "interval_ms": 50
          },
          "expect": {
            "ok": {
              "jobs": {
                "$unordered": [
                  {
                    "id": "ab01",
                    "state": "ended",
                    "code": 0
                  },
                  {
                    "id": "ab02",
                    "state": "running"
                  },
                  {
                    "id": "ab03",
                    "state": "ended",
                    "code": 3
                  }
                ]
              }
            }
          }
        },
        {
          "id": "kill",
          "op": "job_kill",
          "scope": "${SCOPE}",
          "jobs": [
            "ab02"
          ],
          "expect": {
            "ok": {}
          }
        }
      ]
    },
    {
      "id": "jobs.kill.stops-the-group",
      "description": "kill signals the job's whole process group: a child it started dies too.",
      "requires": {
        "jobs": "any"
      },
      "steps": [
        {
          "id": "start",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "ac01",
          "command": "sh",
          "args": [
            "-c",
            "(sleep 1; echo late > \"$1/marker\") & sleep 30"
          ],
          "label": "",
          "expect": {
            "ok": {
              "pgid": {
                "$gt": 0
              }
            }
          }
        },
        {
          "id": "kill",
          "op": "job_kill",
          "scope": "${SCOPE}",
          "jobs": [
            "ac01"
          ],
          "expect": {
            "ok": {
              "survivors": []
            }
          }
        },
        {
          "id": "ended",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "ac01",
          "offset": 0,
          "poll": {
            "timeout_ms": 8000,
            "interval_ms": 50
          },
          "expect": {
            "ok": {
              "state": "ended",
              "code": {
                "$oneof": [
                  137,
                  143
                ]
              }
            }
          }
        },
        {
          "id": "wait",
          "op": "exec",
          "command": "sh",
          "args": [
            "-c",
            "sleep 1.5; ls \"$1\"",
            "sh",
            "${ROOT}"
          ],
          "expect": {
            "ok": {
              "exit_code": 0,
              "stdout_utf8": ""
            }
          }
        }
      ]
    },
    {
      "id": "jobs.kill.escalates-past-sigterm",
      "description": "A job that ignores SIGTERM is killed anyway after the grace: kill returns when the group is empty.",
      "requires": {
        "jobs": "any"
      },
      "steps": [
        {
          "id": "start",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "ac02",
          "command": "sh",
          "args": [
            "-c",
            "trap '' TERM; echo ready; while :; do sleep 1; done"
          ],
          "label": "",
          "expect": {
            "ok": {
              "pgid": {
                "$gt": 0
              }
            }
          }
        },
        {
          "id": "armed",
          "op": "job_read",
          "scope": "${SCOPE}",
