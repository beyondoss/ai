            "ok": {
              "data_utf8": "ready\n"
            }
          }
        },
        {
          "id": "kill",
          "op": "job_kill",
          "scope": "${SCOPE}",
          "jobs": [
            "ac02"
          ],
          "expect": {
            "ok": {
              "survivors": []
            }
          }
        },
        {
          "id": "ended",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "ac02",
          "offset": 0,
          "poll": {
            "timeout_ms": 8000,
            "interval_ms": 50
          },
          "expect": {
            "ok": {
              "state": "ended",
              "code": 137
            }
          }
        }
      ]
    },
    {
      "id": "jobs.kill.ended-job-is-a-noop",
      "description": "Killing a job that already ended signals nothing and succeeds.",
