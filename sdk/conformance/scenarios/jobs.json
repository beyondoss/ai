          ],
          "label": "",
          "expect": {
            "ok": {}
          }
        },
        {
          "id": "my-read",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "ae01",
          "offset": 0,
          "poll": {
            "timeout_ms": 8000,
            "interval_ms": 50
          },
          "expect": {
            "ok": {
              "data_utf8": "mine\n"
            }
          }
        },
        {
          "id": "their-read",
          "op": "job_read",
          "scope": "${SCOPE}-other",
          "job": "ae01",
          "offset": 0,
          "poll": {
            "timeout_ms": 8000,
            "interval_ms": 50
          },
