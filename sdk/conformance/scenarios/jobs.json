        "jobs": "any"
      },
      "steps": [
        {
          "id": "start",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "ac03",
          "command": "sh",
          "args": [
            "-c",
            "exit 2"
          ],
          "label": "",
          "expect": {
            "ok": {
              "pgid": {
                "$gt": 0
              }
            }
          }
        },
        {
          "id": "wait",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "ac03",
          "offset": 0,
          "poll": {
            "timeout_ms": 8000,
            "interval_ms": 50
          },
          "expect": {
            "ok": {
              "state": "ended",
              "code": 2
            }
          }
        },
        {
          "id": "kill",
          "op": "job_kill",
          "scope": "${SCOPE}",
          "jobs": [
            "ac03"
          ],
          "expect": {
            "ok": {
              "survivors": []
            }
          }
        },
        {
          "id": "still",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "ac03",
          "offset": 0,
          "expect": {
            "ok": {
              "state": "ended",
              "code": 2
            }
          }
        }
      ]
    },
    {
      "id": "jobs.kill.with-remove",
      "description": "kill with remove deletes the job once its group is gone: it is then gone, and no longer listed.",
      "requires": {
        "jobs": "any"
      },
      "steps": [
        {
          "id": "start",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "ac04",
          "command": "sh",
          "args": [
            "-c",
            "sleep 30"
          ],
          "label": "",
          "expect": {
            "ok": {
              "pgid": {
                "$gt": 0
              }
            }
          }
        },
        {
          "id": "kill",
