    {
      "id": "jobs.output.is-retained-past-eight-mib",
      "description": "At least the last 8 MiB of a job's output is kept; older output is dropped as a gap of known size, and offsets never move.",
      "requires": {
        "jobs": "any"
      },
      "steps": [
        {
          "id": "start",
          "op": "job_start",
          "scope": "${SCOPE}",
          "job": "aj01",
          "command": "sh",
          "args": [
            "-c",
            "head -c 10485760 /dev/zero | tr '\\000' z"
          ],
          "label": "",
          "expect": {
            "ok": {
              "pgid": {
                "$gt": 0
              }
            }
          }
        },
        {
          "id": "wait",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "aj01",
          "offset": 0,
          "max": 10,
          "poll": {
            "timeout_ms": 30000,
            "interval_ms": 100
          },
          "expect": {
            "ok": {
              "state": "ended"
            }
          }
        },
        {
          "id": "follow",
          "op": "job_attach",
          "scope": "${SCOPE}",
          "job": "aj01",
          "offset": 0,
          "expect": {
            "ok": {
              "output_len": {
                "$gte": 8388608
              },
              "gap": {
                "$gte": 0
              },
              "exit_code": 0
            }
          }
        },
        {
          "id": "tail",
          "op": "job_read",
          "scope": "${SCOPE}",
          "job": "aj01",
          "offset": 10485750,
          "max": 100,
          "expect": {
            "ok": {
              "offset": 10485750,
              "end": 10485760,
              "data_utf8": "zzzzzzzzzz"
            }
          }
        }
      ]
    }
